[Unit]
Description=ResourceWatch — real-time system resource monitoring
Documentation=https://github.com/frammawiliansyah/resourcewatch
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=resourcewatch
Group=resourcewatch
WorkingDirectory=/opt/resourcewatch
ExecStart=/opt/resourcewatch/resourcewatch
Restart=on-failure
RestartSec=2
Environment=RUST_LOG=info

# Port override — `deploy/install.sh --port N` rewrites this line; you can
# also uncomment and edit it by hand instead of editing config.toml:
#Environment=RW_PORT=8090

# If NVML fails to initialize under this dedicated user (permission denied
# reading /dev/nvidia*), uncomment and set this to the group that owns those
# device nodes (commonly "video" or "render" — check with `ls -l /dev/nvidia0`):
# SupplementaryGroups=video

# --- Hardening ---
# Metric collection only ever reads /proc, /sys and device nodes, so the
# service needs no write access outside its own state directory.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
ReadWritePaths=/opt/resourcewatch/data

[Install]
WantedBy=multi-user.target
